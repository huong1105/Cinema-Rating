# ─── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database (SQLite via Prisma) ─────────────────────
DATABASE_URL="file:./dev.db"

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=change-me-to-a-strong-random-string
JWT_EXPIRES_IN=7d

# ─── Bcrypt ───────────────────────────────────────────
BCRYPT_SALT_ROUNDS=10
