{
  "name": "cinerate-api",
  "version": "1.0.0",
  "description": "CineRate Movie Rating Backend API - 3-Layer Architecture with DI",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
