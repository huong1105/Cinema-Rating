    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prisma": "^6.9.0"
  }
